# Copy to /etc/ai-blind-assistant/wearable.env (root:aiba, mode 0640).
# Select a concrete private interface at each start; never binds a wildcard.
# Set an explicit private IP only when interface selection must be overridden.
# Never expose the port through a router or public interface.
AIBA_BIND_HOST=auto
AIBA_PORT=8765
AIBA_DEVICE_NAME=rpi3-ml
AIBA_STATE_DIR=/var/lib/ai-blind-assistant/state
AIBA_LOG_DIR=/var/log/ai-blind-assistant
AIBA_MODEL_DIR=/opt/ai-blind-assistant/model
AIBA_CAMERA_WIDTH=640
AIBA_CAMERA_HEIGHT=480
AIBA_CAMERA_FPS=12
AIBA_NCNN_THREADS=3
AIBA_NMS_THRESHOLD=0.45
AIBA_FRAME_STRIDE=2
AIBA_MAX_ANNOUNCEMENTS_PER_MINUTE=12
AIBA_HEARTBEAT_SECONDS=10
AIBA_STALE_SECONDS=30
AIBA_PAIRING_TTL_SECONDS=300
AIBA_ALLOW_FIRST_CLIENT_ENROLLMENT=true
AIBA_MAX_CAMERA_RESTARTS=3
AIBA_ENABLE_MDNS=true
AIBA_ENABLE_LOCAL_SPEECH=true

# --- SSH Reverse Tunnel (public-WiFi fallback) ---
# Uncomment and set these when the phone and Pi are on an isolated network
# where mDNS (rpi3-ml.local) does not reach the phone.
# The tunnel forwards Pi:8765 -> laptop:8765 so the phone connects to the
# laptop IP instead. The laptop IP MUST be a private-LAN address only.
# Run: systemctl enable --now ai-blind-assistant-tunnel.service
# Or manually: sh /opt/ai-blind-assistant/service/scripts/reverse_tunnel.sh
#
# AIBA_TUNNEL_TARGET_USER=asjad
# AIBA_TUNNEL_TARGET_HOST=192.168.x.x   # your laptop's current LAN IP

