# Optional Gemini primary. Leave both unset to use Ollama only.
# If both are set, GOOGLE_API_KEY takes precedence. Never commit real keys.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama configuration (must be running separately: `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Whisper transcription model size: tiny | base | small. Base is the default
# accuracy/performance balance and is downloaded once, then runs offline.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_LOCAL_FILES_ONLY=true

# Database path (relative to laptop_backend/ working dir)
DB_PATH=./data/assistant.db

# Auth
PAIRING_CODE_TTL=300
TOKEN_TTL_DAYS=30

# Audit
AUDIT_MAX_ROWS=500
# Off by default so transcripts and typed chat are not retained after a session.
PERSIST_CONVERSATION_HISTORY=false

# Server
HOST=0.0.0.0
PORT=8765
LOG_LEVEL=INFO
