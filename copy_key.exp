#!/usr/bin/expect -f
# Forward ssh-copy-id arguments and let SSH prompt interactively for credentials
# and host-key verification. Never embed passwords or auto-accept host keys.
if {$argc == 0} {
    puts stderr "Usage: copy_key.exp ?-i public-key-file? user@private-host"
    exit 2
}
spawn ssh-copy-id {*}$argv
interact
set result [wait]
exit [lindex $result 3]
